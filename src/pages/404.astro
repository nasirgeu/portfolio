---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | Mohd Nasir" description="The page you're looking for could not be found." noindex>
  <section class="section">
    <div class="container-page pt-24 text-center">
      <p class="eyebrow">Error: 404</p>
      <h1 class="section-title mt-3">Page not found.</h1>
      <p class="mx-auto mt-4 max-w-md text-lg text-muted">
        Sorry, the page you're looking for doesn't exist or may have been moved.
      </p>
      <a href="/" class="btn btn-primary mt-8">Back to Home</a>
    </div>
  </section>
</Layout>
