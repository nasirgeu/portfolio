---
import Layout from '../../layouts/Layout.astro';
import WritingSidebar from '../../components/WritingSidebar.astro';
import PageShell from '../../components/PageShell.astro';
import PageHeader from '../../components/PageHeader.astro';
import ShareButton from '../../components/ShareButton.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { relatedForPost } from '../../lib/related';
import { ArrowRight } from 'lucide-react';
import { formatDate, getPostNeighbours, posts, readingMinutes, shortTitle, type Post } from '../../data/writing';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { newer, older } = getPostNeighbours(post.slug);
---

<Layout
  title={`${post.title} | Writing | Mohd Nasir`}
  description={post.summary}
  ogType="article"
  crumbs={[
    { name: 'Writing', path: '/writing/' },
    { name: post.title, path: `/writing/${post.slug}/` },
  ]}
  article={{
    title: post.title,
    description: post.summary,
    datePublished: post.date,
    section: post.group,
    keywords: post.tags,
  }}
>
  <PageShell>
    <WritingSidebar slot="sidebar" current={post.slug} />
    <article aria-labelledby="post-title">
      <PageHeader
        crumbs={[{ label: 'Portfolio', href: '/' }, { label: 'Writing', href: '/writing' }, { label: shortTitle(post) }]}
        chips={[post.group]}
        title={post.title}
        titleId="post-title"
        meta={`${formatDate(post.date)} · ${readingMinutes(post)} min read`}
      >
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <ul class="flex flex-wrap gap-2" aria-label="Topics">
            {post.tags.map((t) => <li class="chip">{t}</li>)}
          </ul>
          <ShareButton title={post.title} />
        </div>
      </PageHeader>

      <div class="mt-10 space-y-5 text-lg leading-relaxed text-muted" data-hero style="--d:80ms">
        {
          post.body.map((b) => {
            if (b.type === 'h2')
              return <h2 class="pt-4 text-2xl font-semibold tracking-tight text-fg">{b.text}</h2>;
            if (b.type === 'list')
              return (
                <ul class="space-y-2">
                  {b.items.map((item) => (
                    <li class="flex gap-3">
                      <span class="mt-3 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              );
            if (b.type === 'code')
              return (
                <figure>
                  {b.caption && <figcaption class="mb-2 font-mono text-xs text-muted">{b.caption}</figcaption>}
                  <pre tabindex="0" class="overflow-x-auto rounded-lg border border-line bg-surface p-4 font-mono text-sm leading-relaxed text-fg"><code>{b.code}</code></pre>
                </figure>
              );
            if (b.type === 'link')
              return (
                <p>
                  <a href={b.href} class="btn btn-primary">
                    {b.text}
                    <ArrowRight size={16} aria-hidden="true" />
                  </a>
                </p>
              );
            return <p>{b.text}</p>;
          })
        }
      </div>

      <RelatedLinks heading="Keep reading" items={relatedForPost(post)} />

      {
        (newer || older) && (
          <nav aria-label="More posts" class="mt-16 grid gap-4 border-t border-line pt-8 sm:grid-cols-2">
            {newer ? (
              <a href={`/writing/${newer.slug}`} class="card card-hover flex flex-col gap-1 p-5">
                <span class="font-mono text-xs text-muted">Newer post</span>
                <span class="font-semibold tracking-tight">{newer.title}</span>
              </a>
            ) : (
              <span />
            )}
            {older && (
              <a href={`/writing/${older.slug}`} class="card card-hover flex flex-col gap-1 p-5 sm:text-right">
                <span class="font-mono text-xs text-muted">Older post</span>
                <span class="font-semibold tracking-tight">{older.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </article>
  </PageShell>
</Layout>
