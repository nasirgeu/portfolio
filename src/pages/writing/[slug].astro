---
import Layout from '../../layouts/Layout.astro';
import WritingSidebar from '../../components/WritingSidebar.astro';
import { ArrowLeft, ArrowRight } from 'lucide-react';
import { formatDate, getPostNeighbours, posts, readingMinutes, type Post } from '../../data/writing';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { newer, older } = getPostNeighbours(post.slug);
---

<Layout title={`${post.title} | Writing | Mohd Nasir`} description={post.summary}>
  <div class="relative pt-24 pb-16 sm:pt-28">
    <div class="hero-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="container-page relative grid grid-cols-1 gap-10 lg:grid-cols-[16rem_minmax(0,1fr)]">
      <WritingSidebar current={post.slug} />
      <article class="min-w-0" aria-labelledby="post-title">
      <a href="/writing" class="inline-flex items-center gap-2 py-2 font-mono text-xs tracking-wider text-accent uppercase">
        <ArrowLeft size={14} aria-hidden="true" />
        All posts
      </a>

      <header class="mt-8" data-hero>
        <p class="font-mono text-xs text-muted">
          <time datetime={post.date}>{formatDate(post.date)}</time> · {readingMinutes(post)} min read
        </p>
        <h1
          id="post-title"
          class="mt-3 text-[clamp(1.9rem,4vw,2.9rem)] leading-[1.1] font-bold tracking-[-0.03em] text-balance"
        >
          {post.title}
        </h1>
        <ul class="mt-5 flex flex-wrap gap-2" aria-label="Topics">
          {post.tags.map((t) => <li class="chip">{t}</li>)}
        </ul>
      </header>

      <div class="mt-10 space-y-5 text-lg leading-relaxed text-muted" data-hero style="--d:80ms">
        {
          post.body.map((b) => {
            if (b.type === 'h2')
              return <h2 class="pt-4 text-2xl font-semibold tracking-tight text-fg">{b.text}</h2>;
            if (b.type === 'list')
              return (
                <ul class="space-y-2">
                  {b.items.map((item) => (
                    <li class="flex gap-3">
                      <span class="mt-3 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              );
            if (b.type === 'code')
              return (
                <figure>
                  {b.caption && <figcaption class="mb-2 font-mono text-xs text-muted">{b.caption}</figcaption>}
                  <pre tabindex="0" class="overflow-x-auto rounded-lg border border-line bg-surface p-4 font-mono text-sm leading-relaxed text-fg"><code>{b.code}</code></pre>
                </figure>
              );
            if (b.type === 'link')
              return (
                <p>
                  <a href={b.href} class="btn btn-primary">
                    {b.text}
                    <ArrowRight size={16} aria-hidden="true" />
                  </a>
                </p>
              );
            return <p>{b.text}</p>;
          })
        }
      </div>

      {
        (newer || older) && (
          <nav aria-label="More posts" class="mt-16 grid gap-4 border-t border-line pt-8 sm:grid-cols-2">
            {newer ? (
              <a href={`/writing/${newer.slug}`} class="card card-hover flex flex-col gap-1 p-5">
                <span class="font-mono text-xs text-muted">Newer post</span>
                <span class="font-semibold tracking-tight">{newer.title}</span>
              </a>
            ) : (
              <span />
            )}
            {older && (
              <a href={`/writing/${older.slug}`} class="card card-hover flex flex-col gap-1 p-5 sm:text-right">
                <span class="font-mono text-xs text-muted">Older post</span>
                <span class="font-semibold tracking-tight">{older.title}</span>
              </a>
            )}
          </nav>
        )
      }
      </article>
    </div>
  </div>
</Layout>
