---
import LabLayout from '../../layouts/LabLayout.astro';
import ExperimentCard from '../../components/lab/ExperimentCard.astro';
import LabSidebar from '../../components/lab/LabSidebar.astro';
import PageShell from '../../components/PageShell.astro';
import PageHeader from '../../components/PageHeader.astro';
import LabArchitecture from '../../components/LabArchitecture';
import { experiments, experimentsByGroup, groupInfo, totalAlgorithms, type ExperimentGroup } from '../../data/labExperiments';

const groups: ExperimentGroup[] = ['os', 'algorithms'];

const stats = [
  { value: String(experiments.length), label: 'live experiments' },
  { value: String(totalAlgorithms), label: 'algorithms to compare' },
  { value: '100%', label: 'runs in your browser' },
];
---

<LabLayout
  title="Engineering Lab | Mohd Nasir"
  description="Interactive experiments that help you understand operating systems and algorithms by trying them yourself, following each step and seeing the results."
>
  <PageShell>
    <LabSidebar slot="sidebar" />
    <PageHeader
      crumbs={[{ label: 'Portfolio', href: '/' }, { label: 'Lab' }]}
      title="Explore. Experiment. Understand."
      intro="I built these interactive experiments to make operating systems and algorithms easier to understand. Try different inputs, follow each step and see how each algorithm works and how its results change."
    >
        <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4" data-hero style="--d:180ms">
          {
            stats.map((s) => (
              <div>
                <dt class="sr-only">{s.label}</dt>
                <dd>
                  <span class="text-3xl font-bold tracking-tight text-accent">{s.value}</span>
                  <span class="ml-2 font-mono text-xs text-muted">{s.label}</span>
                </dd>
              </div>
            ))
          }
        </dl>
    </PageHeader>

        <section class="mt-12" aria-labelledby="experiments-title">
          <h2 id="experiments-title" class="sr-only">Pick an experiment</h2>
          {
            groups.map((g, gi) => (
              <div class:list={[gi > 0 ? 'mt-12' : '']} aria-labelledby={`group-${g}`} role="group">
                <div class="mb-5 flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-line pb-3">
                  <h3 id={`group-${g}`} class="text-xl font-semibold tracking-tight">{groupInfo[g].label}</h3>
                  <p class="text-sm text-muted">{groupInfo[g].blurb}</p>
                </div>
                <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                  {experimentsByGroup(g).map((e) => <ExperimentCard experiment={e} />)}
                </div>
              </div>
            ))
          }
        </section>

        <section class="mt-16" aria-labelledby="about-title">
          <h2 id="about-title" class="mb-5 border-b border-line pb-3 text-xl font-semibold tracking-tight">
            How to use these experiments
          </h2>
          <ul class="grid gap-4 md:grid-cols-3">
            {
              [
                {
                  title: 'Everything runs in your browser',
                  text: 'All calculations happen on your device. Nothing you enter is sent anywhere, so you can try different inputs freely.',
                },
                {
                  title: 'These are simplified learning examples',
                  text: 'Each experiment focuses on explaining one idea clearly. Real-world systems are more complex, so these examples are meant for learning, not production use.',
                },
                {
                  title: 'Every important step is explained',
                  text: "Whenever an algorithm makes a decision, you'll see a simple explanation of what happened and why.",
                },
              ].map((item, i) => (
                <li class="card p-6" data-reveal data-reveal-delay={String(i * 80)}>
                  <p class="font-mono text-xs text-accent">0{i + 1}</p>
                  <h3 class="mt-2 font-semibold">{item.title}</h3>
                  <p class="mt-1.5 text-sm text-muted">{item.text}</p>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="mt-16" aria-labelledby="design-title">
          <h2 id="design-title" class="mb-3 border-b border-line pb-3 text-xl font-semibold tracking-tight">
            How the experiments are built
          </h2>
          <p class="mt-4 mb-8 text-muted">
            All experiments follow the same structure. The algorithm logic is kept separate from the user interface. Each
            decision is saved as a step with an explanation, and automated tests help check that the results are correct.
          </p>
          <LabArchitecture client:visible />
        </section>
  </PageShell>
</LabLayout>
