---
import '../styles/global.css';
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import { ArrowUp } from 'lucide-react';
import BookCallDialog from '../components/BookCallDialog.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import type { ArticleInfo, Crumb } from '../lib/seo';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  /** Keep the page out of search results. */
  noindex?: boolean | undefined;
  ogType?: 'website' | 'article' | undefined;
  /** Breadcrumb trail after "Home", for the structured data. */
  crumbs?: readonly Crumb[] | undefined;
  /** Set on writing posts: adds BlogPosting data. */
  article?: ArticleInfo | undefined;
}

const {
  title = `${site.name} | ${site.title}`,
  description = site.metaDescription,
  noindex = false,
  ogType = 'website',
  crumbs,
  article,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} noindex={noindex} ogType={ogType} crumbs={crumbs} article={article} />
    <meta name="theme-color" content="#f4f7fb" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Apply the saved theme before first paint to avoid a flash. Light is the default for first-time visitors. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (t !== 'dark' && t !== 'light') t = 'light';
          d.setAttribute('data-theme', t);
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', t === 'light' ? '#f4f7fb' : '#0b1220');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="max-md:pb-[4.75rem]">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-fg"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <BookCallDialog />
    <MobileActionBar />
    <button
      type="button"
      data-to-top
      hidden
      aria-label="Back to top"
      data-tip="Back to top"
      class="tip tip-end fixed right-4 bottom-20 z-40 inline-flex size-11 items-center justify-center rounded-lg border border-line-strong bg-surface text-muted transition-colors hover:text-accent sm:right-6 md:bottom-6"
    >
      <ArrowUp size={18} aria-hidden="true" />
    </button>
    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>
