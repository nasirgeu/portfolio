---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import '../styles/global.css';
import { site, education } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ArrowUp } from 'lucide-react';
import BookCallDialog from '../components/BookCallDialog.astro';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
}

const { title = `${site.name} | ${site.title}`, description = site.metaDescription } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImagePath = existsSync(join(process.cwd(), 'public', site.ogImage)) ? site.ogImage : null;
const ogImage = ogImagePath ? new URL(ogImagePath, Astro.site).href : null;
const sameAs = site.socials.map((s) => s.url).filter((u) => u.length > 0);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.name,
    jobTitle: 'Software Engineer',
    url: Astro.site?.href,
    description,
    worksFor: { '@type': 'Organization', name: site.company },
    alumniOf: { '@type': 'CollegeOrUniversity', name: education.university },
    knowsAbout: ['C++', 'C', 'Systems Programming', 'Memory Management', 'Performance Optimization', 'Data Structures and Algorithms'],
    ...(sameAs.length > 0 ? { sameAs } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: `${site.name} | Portfolio`,
    url: Astro.site?.href,
  },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#090c12" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Apply saved theme before first paint to avoid a flash -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          d.setAttribute('data-theme', t);
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', t === 'light' ? '#f4f7fb' : '#090c12');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-fg"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <BookCallDialog />
    <button
      type="button"
      data-to-top
      hidden
      aria-label="Back to top"
      data-tip="Back to top"
      class="tip tip-end fixed right-4 bottom-4 z-40 inline-flex size-11 items-center justify-center rounded-lg border border-line-strong bg-surface text-muted transition-colors hover:text-accent sm:right-6 sm:bottom-6"
    >
      <ArrowUp size={18} aria-hidden="true" />
    </button>
    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>
