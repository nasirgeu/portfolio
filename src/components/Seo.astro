---
/**
 * All the search and social tags for one page, in one place: title, description, canonical link, Open Graph, Twitter
 * card, an optional noindex, and the JSON-LD graph. Layout.astro renders this once per page.
 */
import { site } from '../data/site';
import { absoluteUrl, buildGraph, type ArticleInfo, type Crumb } from '../lib/seo';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  title: string;
  description: string;
  /** Path of this page. Defaults to the current URL. */
  path?: string | undefined;
  /** Keep this page out of search results (for example the 404 page). */
  noindex?: boolean | undefined;
  ogType?: 'website' | 'article' | undefined;
  crumbs?: readonly Crumb[] | undefined;
  article?: ArticleInfo | undefined;
}

const { title, description, path = Astro.url.pathname, noindex = false, ogType = 'website', crumbs, article } = Astro.props;

const canonical = absoluteUrl(Astro.site, path);
const ogImagePath = existsSync(join(process.cwd(), 'public', site.ogImage)) ? site.ogImage : null;
const ogImage = ogImagePath ? absoluteUrl(Astro.site, ogImagePath) : null;
const jsonLd = buildGraph({ base: Astro.site, path, title, description, crumbs, article, image: ogImage });
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={site.name} />
{noindex && <meta name="robots" content="noindex, follow" />}
<link rel="canonical" href={canonical} />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{ogImage && <meta property="og:image" content={ogImage} />}
{article && <meta property="article:published_time" content={article.datePublished} />}
{article?.section && <meta property="article:section" content={article.section} />}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
