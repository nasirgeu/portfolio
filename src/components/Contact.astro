---
import { ArrowUpRight, CalendarDays, Copy, Download } from 'lucide-react';
import { site, contact } from '../data/site';
import Icon from './Icon.astro';

const socials = site.socials.filter((s) => s.url.length > 0);
const hasEmail = site.email.length > 0;
const hasBooking = site.bookingUrl.length > 0;
const hasResume = site.resumeUrl.length > 0;

/* One row of the contact list: flat, divided by hairlines like the rest of the page (no boxes). */
const row =
  'group flex w-full items-center gap-4 py-4 text-left transition-colors hover:text-accent';
const icon = 'inline-flex size-9 shrink-0 items-center justify-center rounded-lg border border-line text-accent transition-colors group-hover:border-accent/50';
---

<section id="contact" class="section border-t border-line" aria-labelledby="contact-title">
  <div class="container-page grid items-start gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-20" data-reveal>
    <!-- Left: the message -->
    <div class="min-w-0">
      <p class="eyebrow section-eyebrow mb-3">Contact</p>
      <h2 id="contact-title" class="section-title">{contact.heading}</h2>
      {contact.paragraphs.map((p) => <p class="mt-4 max-w-md text-base text-muted sm:text-lg">{p}</p>)}
      {
        site.availability.show && (
          <p class="mt-6 inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1.5 text-sm text-muted">
            <span
              class:list={['status-dot size-2 rounded-full', site.availability.status === 'open' ? 'bg-accent' : 'bg-warn']}
              aria-hidden="true"
            />
            {site.availability.label}
          </p>
        )
      }
    </div>

    <!-- Right: ways to get in touch -->
    <div class="min-w-0">
      <h3 class="sr-only">Ways to get in touch</h3>
      <ul class="divide-y divide-line border-y border-line">
        {
          hasEmail ? (
            <li class="flex items-center gap-2">
              <a href={`mailto:${site.email}`} class={`${row} min-w-0 flex-1`}>
                <span class={icon}>
                  <Icon name="mail" size={18} />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block font-semibold">Email me</span>
                  <span class="block font-mono text-xs break-all text-muted sm:text-sm">{site.email}</span>
                </span>
                <ArrowUpRight size={16} aria-hidden="true" className="shrink-0 text-muted transition-colors group-hover:text-accent" />
              </a>
              <button
                type="button"
                class="inline-flex min-h-9 shrink-0 items-center gap-2 rounded-lg border border-line px-3 text-sm text-muted transition-colors hover:border-line-strong hover:text-fg"
                data-copy={site.email}
                aria-live="polite"
                aria-label="Copy email address"
              >
                <Copy size={16} aria-hidden="true" />
                <span class="hidden sm:inline" data-copy-label>Copy</span>
              </button>
            </li>
          ) : (
            <li class="py-4 text-muted" role="note">
              Email not set. Add it in src/data/site.ts
            </li>
          )
        }
        {
          hasBooking && (
            <li>
              <button type="button" class={row} data-book-call aria-haspopup="dialog">
                <span class={icon}>
                  <CalendarDays size={18} aria-hidden="true" />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block font-semibold">{site.bookingLabel}</span>
                  <span class="block text-sm text-muted">Choose a 30-minute time slot that works for you.</span>
                </span>
                <ArrowUpRight size={16} aria-hidden="true" className="shrink-0 text-muted transition-colors group-hover:text-accent" />
              </button>
            </li>
          )
        }
        {
          hasResume && (
            <li>
              <a href={site.resumeUrl} download={site.resumeFileName} class={row}>
                <span class={icon}>
                  <Download size={18} aria-hidden="true" />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block font-semibold">Download resume</span>
                  <span class="block text-sm text-muted">Download my latest resume as a PDF.</span>
                </span>
                <ArrowUpRight size={16} aria-hidden="true" className="shrink-0 text-muted transition-colors group-hover:text-accent" />
              </a>
            </li>
          )
        }
      </ul>

      {
        socials.length > 0 && (
          <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2">
            <p class="font-mono text-xs tracking-wider text-muted uppercase">Find me online</p>
            <ul class="flex flex-wrap gap-x-5 gap-y-1" aria-label="Social links">
              {socials.map((s) => (
                <li>
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-9 items-center gap-2 text-sm font-medium text-muted transition-colors hover:text-accent"
                    aria-label={`${s.label} (opens in a new tab)`}
                  >
                    <Icon name={s.icon} size={18} />
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</section>
