---
import { ArrowUpRight, CalendarDays, Copy, Download } from 'lucide-react';
import { site, contact } from '../data/site';
import Icon from './Icon.astro';

const socials = site.socials.filter((s) => s.url.length > 0);
const hasEmail = site.email.length > 0;
const hasBooking = site.bookingUrl.length > 0;
const hasResume = site.resumeUrl.length > 0;

/* One row of the contact list: an icon tile, a title with a hint, and an arrow. */
const row =
  'group flex w-full items-center gap-4 rounded-xl border border-line bg-bg p-4 text-left transition-colors hover:border-accent hover:bg-accent-soft';
const tile =
  'inline-flex size-11 shrink-0 items-center justify-center rounded-lg border border-accent/40 bg-accent-soft text-accent';
---

<section id="contact" class="section border-t border-line" aria-labelledby="contact-title">
  <div class="container-page">
    <div class="card overflow-hidden" data-reveal>
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.1fr]">
        <!-- Left: the message -->
        <div class="relative flex min-w-0 flex-col justify-center p-6 sm:p-12 lg:p-14">
          <div
            class="pointer-events-none absolute inset-0"
            style="background: radial-gradient(28rem 18rem at 0% 0%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 70%)"
            aria-hidden="true"
          >
          </div>
          <div class="relative">
            <p class="eyebrow section-eyebrow mb-3">Contact</p>
            <h2 id="contact-title" class="section-title">{contact.heading}</h2>
            {contact.paragraphs.map((p) => <p class="mt-4 max-w-md text-lg text-muted">{p}</p>)}
            {
              site.availability.show && (
                <p class="mt-6 inline-flex items-center gap-2 rounded-full border border-line bg-bg px-3 py-1.5 text-sm text-muted">
                  <span
                    class:list={['status-dot size-2 rounded-full', site.availability.status === 'open' ? 'bg-accent' : 'bg-warn']}
                    aria-hidden="true"
                  />
                  {site.availability.label}
                </p>
              )
            }
          </div>
        </div>

        <!-- Right: ways to get in touch -->
        <div class="min-w-0 border-t border-line bg-surface-2/40 p-5 sm:p-10 lg:border-t-0 lg:border-l lg:p-12">
          <h3 class="sr-only">Ways to get in touch</h3>
          <ul class="flex flex-col gap-3">
            {
              hasEmail ? (
                <li class="flex items-stretch gap-2">
                  <a href={`mailto:${site.email}`} class={`${row} min-w-0 flex-1 !border-accent !bg-accent-soft`}>
                    <span class={tile}>
                      <Icon name="mail" size={20} />
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="block font-semibold">Email me</span>
                      <span class="block font-mono text-xs break-all text-muted sm:text-sm">{site.email}</span>
                    </span>
                    <ArrowUpRight size={18} aria-hidden="true" className="shrink-0 text-accent" />
                  </a>
                  <button
                    type="button"
                    class="btn !min-h-0 shrink-0 !rounded-xl !px-4"
                    data-copy={site.email}
                    aria-live="polite"
                    aria-label="Copy email address"
                  >
                    <Copy size={18} aria-hidden="true" />
                    <span class="hidden sm:inline" data-copy-label>Copy</span>
                  </button>
                </li>
              ) : (
                <li class={row} role="note">
                  Email not set. Add it in src/data/site.ts
                </li>
              )
            }
            {
              hasBooking && (
                <li>
                  <button type="button" class={row} data-book-call aria-haspopup="dialog">
                    <span class={tile}>
                      <CalendarDays size={20} aria-hidden="true" />
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="block font-semibold">{site.bookingLabel}</span>
                      <span class="block text-sm text-muted">Choose a 30-minute time slot that works for you.</span>
                    </span>
                    <ArrowUpRight size={18} aria-hidden="true" className="shrink-0 text-muted transition-colors group-hover:text-accent" />
                  </button>
                </li>
              )
            }
            {
              hasResume && (
                <li>
                  <a href={site.resumeUrl} download={site.resumeFileName} class={row}>
                    <span class={tile}>
                      <Download size={20} aria-hidden="true" />
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="block font-semibold">Download resume</span>
                      <span class="block text-sm text-muted">Download my latest resume as a PDF.</span>
                    </span>
                    <ArrowUpRight size={18} aria-hidden="true" className="shrink-0 text-muted transition-colors group-hover:text-accent" />
                  </a>
                </li>
              )
            }
          </ul>

          {
            socials.length > 0 && (
              <>
                <p class="mt-8 mb-3 font-mono text-xs tracking-wider text-muted uppercase">Find me online:</p>
                <ul class="grid grid-cols-3 gap-3" aria-label="Social links">
                  {socials.map((s) => (
                    <li>
                      <a
                        href={s.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex min-h-14 flex-col items-center justify-center gap-1 rounded-xl border border-line bg-bg px-2 py-3 text-sm font-medium transition-colors hover:border-accent hover:text-accent sm:flex-row sm:gap-2"
                        aria-label={`${s.label} (opens in a new tab)`}
                      >
                        <Icon name={s.icon} size={18} />
                        {s.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
