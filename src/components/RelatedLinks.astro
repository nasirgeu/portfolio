---
import { ArrowRight } from 'lucide-react';
import type { RelatedItem } from '../lib/related';

interface Props {
  heading: string;
  items: readonly RelatedItem[];
}
const { heading, items } = Astro.props;
---

{
  items.length > 0 && (
    <nav aria-label={heading} class="mt-14">
      <h2 class="text-xl font-semibold tracking-tight">{heading}</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {items.map((item) => (
          <li>
            <a href={item.href} class="card card-hover group flex h-full flex-col gap-1 p-5">
              <span class="font-mono text-xs text-muted">{item.hint}</span>
              <span class="flex items-start justify-between gap-3 font-semibold tracking-tight">
                {item.title}
                <ArrowRight size={16} aria-hidden="true" className="mt-1 shrink-0 text-accent transition-transform group-hover:translate-x-1" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
