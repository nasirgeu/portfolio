---
import LabBreadcrumbs from './lab/LabBreadcrumbs.astro';

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  crumbs: readonly Crumb[];
  title: string;
  intro?: string | undefined;
  /** Small labels above the title, such as a category. */
  chips?: readonly string[] | undefined;
  /** Shows the "Live experiment" marker next to the chips. */
  live?: boolean | undefined;
  /** One short line under the title, such as a date and reading time. */
  meta?: string | undefined;
  /** id for the title, when something else (such as an article) points to it. */
  titleId?: string | undefined;
}
const { crumbs, title, intro, chips = [], live = false, meta, titleId } = Astro.props;
---

<header class="pb-6">
  <LabBreadcrumbs items={crumbs} />

  <div class="mt-6">
    {
      (chips.length > 0 || live) && (
        <div class="flex flex-wrap items-center gap-3">
          {chips.map((c) => <span class="chip !border-accent/50 !text-accent">{c}</span>)}
          {live && <span class="lab-live">Live experiment</span>}
        </div>
      )
    }
    <h1
      id={titleId}
      class:list={[
        'section-title',
        chips.length > 0 || live ? 'mt-3' : '',
      ]}
      data-hero
    >
      {title}
    </h1>
    {meta && <p class="mt-3 font-mono text-xs text-muted">{meta}</p>}
    {intro && <p class="mt-4 text-lg text-muted">{intro}</p>}
    <slot />
  </div>
</header>
