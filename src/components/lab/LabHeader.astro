---
import type { Experiment } from '../../data/labExperiments';
import LabBreadcrumbs from './LabBreadcrumbs.astro';

interface Props {
  experiment: Experiment;
}
const { experiment } = Astro.props;
---

<header class="relative pt-24 pb-8 sm:pt-28">
  <div class="lab-grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="lab-container relative">
    <LabBreadcrumbs
      items={[
        { label: 'Portfolio', href: '/' },
        { label: 'Lab', href: '/lab' },
        { label: experiment.name },
      ]}
    />

    <div class="mt-6">
      <div class="flex flex-wrap items-center gap-3">
        <span class="chip !border-accent/50 !text-accent">{experiment.category}</span>
        <span class="lab-live">Live experiment</span>
      </div>
      <h1 class="mt-3 text-[clamp(1.8rem,3.2vw,2.5rem)] leading-[1.1] font-bold tracking-[-0.03em] text-balance">
        {experiment.name}
      </h1>
      <p class="mt-4 text-lg text-muted">{experiment.description}</p>
    </div>
  </div>
</header>
