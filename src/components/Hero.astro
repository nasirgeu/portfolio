---
import { ArrowRight } from 'lucide-react';
import { site } from '../data/site';
import Terminal from './Terminal.astro';
import ResumeButton from './ResumeButton.astro';
import BookCallButton from './BookCallButton.astro';
import Icon from './Icon.astro';

// Decorative "memory map": deterministic cells so the build is stable.
const COLS = 16;
const ROWS = 9;
const cells = Array.from({ length: COLS * ROWS }, (_, i) => ({
  show: (i * 7) % 5 !== 0,
  delay: ((i * 37) % 53) / 10,
}));

const terminalLines = [
  { kind: 'cmd', text: 'whoami' },
  { kind: 'out', text: `${site.name.toLowerCase().replace(' ', '-')}: software engineer @ ${site.company.toLowerCase()}` },
  { kind: 'cmd', text: 'cat focus.txt' },
  { kind: 'out', text: 'c/c++ · systems · memory · performance · dsa' },
  { kind: 'cmd', text: './status --availability' },
  { kind: 'out', text: site.availability.show ? `● ${site.availability.label.toLowerCase()}` : '● heads down' },
] as const;

// Optional interactive commands. Every line is taken from facts already on the site.
const terminalCommands: Record<string, string[]> = {
  help: ['whoami · role · expertise · experience · achievements · projects · contact · clear'],
  whoami: [site.name],
  role: [`Software Engineer @ ${site.company}`],
  expertise: ['C++ | Systems Programming | Memory Management | Concurrency'],
  experience: ['2+ years of C++ at Tally Solutions'],
  achievements: ['1,700+ LeetCode problems solved · Knight · peak rating 1989', 'AIR 3 Coding Ninjas · Top 100 HackWithInfy 2024'],
  projects: ['Custom memory manager | Core components | Engineering Lab'],
  contact: [site.email],
};

const socials = site.socials.filter((s) => s.url.length > 0);

// Headline "types in" once on load. Pure CSS: each letter fades in after a small delay,
// so there is no JavaScript, no layout shift and the full text is always in the page.
const START = 0.55; // seconds before typing begins
const STEP = 0.035; // seconds per letter
let n = 0;
const typed = (text: string) =>
  text
    .trim()
    .split(' ')
    .map((word) => ({
      chars: [...word].map((ch) => ({ ch, delay: (START + n++ * STEP).toFixed(3) })),
    }));
const line1 = typed(site.headline[0]);
const line2 = typed(site.headline[1]);

// The paragraph types in right after the headline, a little faster because it is longer.
const PARA_START = START + n * STEP + 0.1;
const PARA_STEP = 0.008;
const paragraph = site.description
  .trim()
  .split(' ')
  .map((word, i, all) => ({
    last: i === all.length - 1,
    chars: [...word].map((ch) => ({ ch })),
  }));
let p = 0;
const paraWords = paragraph.map((w) => ({
  last: w.last,
  chars: w.chars.map((c) => ({ ch: c.ch, delay: (PARA_START + p++ * PARA_STEP).toFixed(3) })),
}));
---

<section id="top" tabindex="-1" class="relative outline-none overflow-hidden pt-28 pb-16 sm:pt-36 lg:pt-40 lg:pb-24">
  <div class="hero-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="hero-grid absolute inset-0" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute top-24 right-[-2rem] hidden gap-1.5 md:grid"
    style={`grid-template-columns: repeat(${COLS}, 0.9rem); mask-image: linear-gradient(to left, #000 10%, transparent 85%); -webkit-mask-image: linear-gradient(to left, #000 10%, transparent 85%);`}
    aria-hidden="true"
  >
    {
      cells.map((c) => (
        <span
          class:list={['block aspect-square', c.show ? 'mem-cell' : '']}
          style={c.show ? `animation-delay:${c.delay}s` : undefined}
        />
      ))
    }
  </div>

  <div class="container-page relative grid items-center gap-12 lg:grid-cols-[1.15fr_1fr]">
    <div>
      {
        site.availability.show && (
          <p
            class="mb-6 inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1.5 text-sm text-muted"
            data-hero
          >
            <span
              class:list={[
                'status-dot inline-block size-2 rounded-full',
                site.availability.status === 'open' ? 'bg-accent' : 'bg-warn',
              ]}
              aria-hidden="true"
            />
            {site.availability.label}
          </p>
        )
      }
      <p class="eyebrow mb-4" data-hero style="--d:60ms">{site.title}</p>
      <h1
        class="text-[clamp(2.3rem,4.8vw,3.6rem)] leading-[1.05] font-bold tracking-[-0.04em] text-balance"
        data-hero
        style="--d:100ms"
      >
        <span class="block">{site.name}</span>
        <span class="mt-3 block text-[0.62em] leading-[1.15] font-semibold tracking-[-0.03em] text-muted">
          <span class="sr-only">{site.headline[0]} {site.headline[1]}</span>
          <span aria-hidden="true">
            {
              line1.map((w) => (
                <>
                  <span class="inline-block whitespace-nowrap">
                    {w.chars.map((c) => (
                      <span class="type-char" style={`animation-delay:${c.delay}s`}>
                        {c.ch}
                      </span>
                    ))}
                  </span>{' '}
                </>
              ))
            }
            <span class="text-fg">
              {
                line2.map((w, i) => (
                  <>
                    <span class="inline-block whitespace-nowrap">
                      {w.chars.map((c) => (
                        <span class="type-char" style={`animation-delay:${c.delay}s`}>
                          {c.ch}
                        </span>
                      ))}
                    </span>
                    {i < line2.length - 1 ? ' ' : ''}
                  </>
                ))
              }
            </span>
            <span class="type-caret" style={`animation-delay:${START}s`}></span>
          </span>
        </span>
      </h1>
      <p class="mt-6 text-base text-muted sm:text-lg" data-hero style="--d:160ms">
        <span class="sr-only">{site.description}</span>
        <span aria-hidden="true">
          {
            paraWords.map((w) => (
              <>
                <span class="inline-block whitespace-nowrap">
                  {w.chars.map((c) => (
                    <span class="type-char" style={`animation-delay:${c.delay}s`}>
                      {c.ch}
                    </span>
                  ))}
                </span>
                {w.last ? '' : ' '}
              </>
            ))
          }
        </span>
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3" data-hero style="--d:220ms">
        <ResumeButton />
        <a href="#projects" class="btn">
          Explore Projects
          <ArrowRight size={18} aria-hidden="true" />
        </a>
        <BookCallButton />
      </div>

      {
        socials.length > 0 && (
          <ul class="mt-8 flex items-center gap-2" aria-label="Social links" data-hero style="--d:280ms">
            {socials.map((s) => (
              <li>
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-tip={s.label}
                  class="tip inline-flex size-11 items-center justify-center rounded-lg border border-line text-muted transition-colors hover:border-line-strong hover:text-fg"
                  aria-label={`${s.label} (opens in a new tab)`}
                >
                  <Icon name={s.icon} size={20} />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div data-hero style="--d:200ms">
      <Terminal lines={[...terminalLines]} commands={terminalCommands} />
    </div>
  </div>
</section>
