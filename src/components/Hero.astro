---
import { ArrowRight } from 'lucide-react';
import { site } from '../data/site';
import HeroChip from './HeroChip.astro';
import ResumeButton from './ResumeButton.astro';
import Icon from './Icon.astro';

const socials = site.socials.filter((s) => s.url.length > 0);

// Headline "types in" once on load. Pure CSS: each letter fades in after a small delay,
// so there is no JavaScript, no layout shift and the full text is always in the page.
const START = 0.55; // seconds before typing begins
const STEP = 0.035; // seconds per letter
let n = 0;
const typed = (text: string) =>
  text
    .trim()
    .split(' ')
    .map((word) => ({
      chars: [...word].map((ch) => ({ ch, delay: (START + n++ * STEP).toFixed(3) })),
    }));
const headline = typed(site.headline);

// The paragraph types in right after the headline, a little faster because it is longer.
const PARA_START = START + n * STEP + 0.1;
const PARA_STEP = 0.008;
const paragraph = site.description
  .trim()
  .split(' ')
  .map((word, i, all) => ({
    last: i === all.length - 1,
    chars: [...word].map((ch) => ({ ch })),
  }));
let p = 0;
const paraWords = paragraph.map((w) => ({
  last: w.last,
  chars: w.chars.map((c) => ({ ch: c.ch, delay: (PARA_START + p++ * PARA_STEP).toFixed(3) })),
}));
---

<section id="top" tabindex="-1" class="relative flex min-h-[calc(min(100svh,72rem)-4.5rem)] flex-col justify-center overflow-hidden pt-24 pb-8 outline-none sm:pt-28 lg:pt-24 lg:pb-8">
  <div class="hero-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="hero-grid absolute inset-0" aria-hidden="true"></div>
  <div class="container-page relative grid items-center gap-12 lg:grid-cols-[1.15fr_1fr]">
    <div class="min-w-0">
      <div class="flex flex-col items-start gap-2.5" data-hero>
        {
          site.availability.show && (
            <p class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface px-2.5 py-1 text-xs text-muted">
              <span
                class:list={[
                  'status-dot inline-block size-1.5 rounded-full',
                  site.availability.status === 'open' ? 'bg-accent' : 'bg-warn',
                ]}
                aria-hidden="true"
              />
              {site.availability.label}
            </p>
          )
        }
        <p class="eyebrow !tracking-[0.05em]">Software Engineer · C++ · Systems Programming</p>
      </div>

      <h1 class="hero-name mt-5 text-[clamp(2.1rem,4.2vw,3.2rem)] leading-[1.05] font-bold tracking-[-0.04em]" data-hero style="--d:80ms">
        {site.name}
      </h1>
      <p class="hero-headline mt-3 max-w-xl text-[clamp(1.3rem,2.3vw,1.8rem)] leading-[1.2] font-semibold tracking-[-0.02em] text-balance" data-hero style="--d:120ms">
        <span class="sr-only">{site.headline}</span>
        <span aria-hidden="true">
          {
            headline.map((w, i) => (
              <>
                <span class="inline-block whitespace-nowrap">
                  {w.chars.map((c) => (
                    <span class="type-char" style={`animation-delay:${c.delay}s`}>
                      {c.ch}
                    </span>
                  ))}
                </span>
                {i < headline.length - 1 ? ' ' : ''}
              </>
            ))
          }
        </span>
      </p>
      <p class="hero-intro mt-4 max-w-xl text-base leading-relaxed text-muted" data-hero style="--d:160ms">
        <span class="sr-only">{site.description}</span>
        <span aria-hidden="true">
          {
            paraWords.map((w) => (
              <>
                <span class="inline-block whitespace-nowrap">
                  {w.chars.map((c) => (
                    <span class="type-char" style={`animation-delay:${c.delay}s`}>
                      {c.ch}
                    </span>
                  ))}
                </span>
                {w.last ? '' : ' '}
              </>
            ))
          }
        </span>
      </p>

      <div class="hero-cta mt-7 flex flex-wrap items-center gap-3" data-hero style="--d:220ms">
        <span class="hidden md:contents"><ResumeButton /></span>
        <a href="#projects" class="btn">
          Explore Projects
          <ArrowRight size={18} aria-hidden="true" />
        </a>
      </div>

      {
        socials.length > 0 && (
          <ul class="hero-social mt-6 flex items-center gap-2" aria-label="Social links" data-hero style="--d:280ms">
            {socials.map((s) => (
              <li>
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-tip={s.label}
                  class="tip inline-flex size-11 items-center justify-center rounded-lg border border-line text-muted transition-colors hover:border-line-strong hover:text-fg"
                  aria-label={`${s.label} (opens in a new tab)`}
                >
                  <Icon name={s.icon} size={20} />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    {/* The right-hand slot: the 3D processor scene. Decoration only, and hidden on small screens. */}
    <div class="relative hidden h-[27rem] lg:block" aria-hidden="true">
      <HeroChip />
    </div>
  </div>
</section>

<script>
  // Primary buttons follow the mouse by a few pixels (mouse only, never with reduced motion).
  import "../scripts/magnetic";
</script>
