---
import { ArrowUpRight, Check } from 'lucide-react';
import { proof } from '../data/site';
import { leetcode, ratingHistory } from '../data/leetcode';

const external = (href: string): boolean => href.startsWith('http');
const fmt = (n: number): string => n.toLocaleString('en-US');

/* ---------- Problems solved: a ring with one section for each difficulty ---------- */
const levels = [
  { id: 'easy', label: 'Easy', colour: 'var(--accent)', ...leetcode.solved.easy, beats: leetcode.beats.easy },
  { id: 'medium', label: 'Medium', colour: 'var(--warn)', ...leetcode.solved.medium, beats: leetcode.beats.medium },
  { id: 'hard', label: 'Hard', colour: 'var(--hard)', ...leetcode.solved.hard, beats: leetcode.beats.hard },
];
// A percentage split into its whole part and its decimals, so the decimals can be drawn smaller (99 and .91%).
const pctParts = (n: number): [string, string] => {
  const [whole, dec] = Number(n.toFixed(2)).toString().split('.');
  return [whole as string, `${dec ? '.' + dec : ''}%`];
};
const overallBeats = pctParts(leetcode.beats.overall);
const solvedTotal = levels.reduce((s, l) => s + l.solved, 0);

const C = 60; // centre of the 120 x 120 ring
const R = 52;
const GAP = 3; // degrees of space between sections (a very small gap)
// The whole ring is the problems you solved, shared out by difficulty: each section is as long as its share of the 1,747.
const ROOM = 360 - levels.length * GAP;
const point = (deg: number): string => {
  const a = ((deg - 90) * Math.PI) / 180;
  return `${(C + R * Math.cos(a)).toFixed(2)} ${(C + R * Math.sin(a)).toFixed(2)}`;
};
const arc = (from: number, to: number): string => `M ${point(from)} A ${R} ${R} 0 ${to - from > 180 ? 1 : 0} 1 ${point(to)}`;
let cursor = GAP / 2;
const sections = levels.map((l) => {
  const span = ROOM * (l.solved / solvedTotal);
  const section = { ...l, path: arc(cursor, cursor + span) };
  cursor += span + GAP;
  return section;
});

/* ---------- Memory manager: a small picture of the block-based design ---------- */
const memoryBlocks = [0, 1, 2, 3, 4, 5, 6, 7];
const BLOCK_W = 34;
const BLOCK_STEP = 38;
const BLOCK_X0 = 10;
const BLOCK_Y = 22;
const BLOCK_H = 46;
const blockX = (i: number): number => BLOCK_X0 + i * BLOCK_STEP;

/* ---------- Contest rating: a line over time, with the highest point marked ---------- */
const W = 320;
const H = 116;
const PAD = { top: 26, right: 8, bottom: 8, left: 8 };
const times = ratingHistory.map(([d]) => new Date(`${d}T00:00:00Z`).getTime());
const ratings = ratingHistory.map(([, r]) => r);
const tMin = Math.min(...times);
const tMax = Math.max(...times);
const rMin = Math.floor((Math.min(...ratings) - 60) / 100) * 100;
const rMax = Math.ceil((Math.max(...ratings) + 20) / 100) * 100;
// Contests are spaced evenly, so the line is easy to read even where there were long gaps between contests.
const x = (i: number): number => PAD.left + (i / (ratingHistory.length - 1)) * (W - PAD.left - PAD.right);
const y = (r: number): number => PAD.top + (1 - (r - rMin) / (rMax - rMin)) * (H - PAD.top - PAD.bottom);
const pts = ratingHistory.map((_, i) => [x(i), y(ratings[i] as number)] as const);
const line = pts.map(([px, py], i) => `${i === 0 ? 'M' : 'L'} ${px.toFixed(1)} ${py.toFixed(1)}`).join(' ');
const area = `${line} L ${pts[pts.length - 1]![0].toFixed(1)} ${H - PAD.bottom} L ${pts[0]![0].toFixed(1)} ${H - PAD.bottom} Z`;
const peakIndex = ratings.indexOf(Math.max(...ratings));
const [peakX, peakY] = pts[peakIndex] as readonly [number, number];
const [endX, endY] = pts[pts.length - 1] as readonly [number, number];
const grid = [1500, 1750, 2000].filter((g) => g > rMin && g < rMax);
const year = (t: number): string => String(new Date(t).getUTCFullYear());
const monthYear = (t: number): string => new Date(t).toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const ratingSummary = `Contest rating from ${fmt(ratings[0] as number)} in ${monthYear(tMin)} to a high of ${fmt(leetcode.contests.peak)} in ${monthYear(times[peakIndex] as number)}, now ${fmt(leetcode.contests.current)} after ${leetcode.contests.attended} contests.`;

const sourceLink =
  'mt-auto inline-flex items-center gap-1 self-end pt-5 text-right font-mono text-xs text-accent hover:underline';
---

<section aria-label="Highlights" class="highlights-band">
  <div class="container-page">
    <ul class="grid divide-y divide-line border-y border-line lg:grid-cols-3 lg:divide-x lg:divide-y-0" data-reveal>
      <!-- 1. Problems solved -->
      <li class="ring-card flex min-w-0 flex-col p-6 lg:pl-0">
        <p class="font-mono text-xs tracking-wider text-muted uppercase">LeetCode problems solved</p>
        <div class="mt-5 flex items-center gap-5">
          <!-- Point at the ring for the overall "Beats" percentage, or at a difficulty for that level's own percentage. -->
          <div
            class="ring-hit relative size-36 shrink-0 rounded-full"
            tabindex="0"
            role="img"
            aria-label={`${fmt(solvedTotal)} problems solved: ${levels.map((l) => `${l.label} ${l.solved}`).join(', ')}. Beats ${leetcode.beats.overall}% of users overall.`}
          >
            <svg viewBox="0 0 120 120" class="size-full" aria-hidden="true">
              {
                sections.map((s) => (
                  <g class={`seg seg-${s.id}`}>
                    <path d={s.path} fill="none" stroke={s.colour} stroke-width="3.5" stroke-linecap="butt" />                  </g>
                ))
              }
            </svg>
            <div class="ring-c ring-c-solved" aria-hidden="true">
              <p class="leading-none font-bold tracking-tight">
                <span class="text-2xl" data-count={solvedTotal}>{fmt(solvedTotal)}</span>
              </p>
              <p class="mt-1 inline-flex items-center gap-1 text-xs text-muted"><Check size={12} className="text-accent" /> Solved</p>
            </div>
            {
              levels.map((l) => {
                const [whole, dec] = pctParts(l.beats);
                return (
                  <div class={`ring-c ring-c-${l.id}`} aria-hidden="true">
                    <p class="text-xs text-muted">Beats</p>
                    <p class="leading-none font-bold tracking-tight">
                      <span class="text-2xl">{whole}</span><span class="text-xs font-medium text-muted">{dec}</span>
                    </p>
                    <p class="mt-1 text-xs text-muted">of users</p>
                  </div>
                );
              })
            }
            <div class="ring-c ring-c-all" aria-hidden="true">
              <p class="text-xs text-muted">Beats</p>
              <p class="leading-none font-bold tracking-tight">
                <span class="text-2xl">{overallBeats[0]}</span><span class="text-xs font-medium text-muted">{overallBeats[1]}</span>
              </p>
              <p class="mt-1 text-xs text-muted">of users</p>
            </div>
          </div>
          <ul class="flex w-full min-w-0 flex-col gap-2">
            {
              levels.map((l) => (
                <li>
                  <button
                    type="button"
                    class={`lv lv-${l.id} flex w-full items-center justify-between gap-3 rounded-lg border border-line bg-bg px-3 py-2 text-xs`}
                    style={`--c:${l.colour}`}
                  >
                    <span class="inline-flex items-center gap-1.5 text-muted">
                      <span class="size-1.5 rounded-full" style={`background:${l.colour}`} aria-hidden="true" />
                      {l.label}
                    </span>
                    <span class="font-mono text-xs">
                      <span class="font-semibold text-fg">{l.solved}</span>
                    </span>
                    <span class="sr-only">
                      , beats {l.beats}% of users
                    </span>
                  </button>
                </li>
              ))
            }
          </ul>
        </div>
        <a href={leetcode.profileUrl} target="_blank" rel="noopener noreferrer" class={sourceLink}>
          See source: LeetCode profile
          <ArrowUpRight size={14} aria-hidden="true" />
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      </li>

      <!-- 2. Contest rating -->
      <li class="flex min-w-0 flex-col p-6">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="font-mono text-xs tracking-wider text-muted uppercase">Contest rating</p>
            <p class="mt-1 text-4xl font-bold tracking-tight" data-count={leetcode.contests.current}>{fmt(leetcode.contests.current)}</p>
          </div>
          <dl class="grid grid-cols-[auto_auto] gap-x-4 gap-y-0.5 text-right text-sm">
            <dt class="text-muted">Highest</dt>
            <dd class="font-semibold">{fmt(leetcode.contests.peak)}</dd>
            <dt class="text-muted">Contests</dt>
            <dd class="font-semibold">{leetcode.contests.attended}</dd>
            <dt class="text-muted">Top</dt>
            <dd class="font-semibold">{leetcode.contests.topPercent}%</dd>
          </dl>
        </div>
        <div
          class="rating-chart relative mt-3"
          data-w={W}
          data-h={H}
          data-points={JSON.stringify(pts.map(([px, py], i) => [Number(px.toFixed(1)), Number(py.toFixed(1)), ratings[i], ratingHistory[i]![0]]))}
        >
        <svg viewBox={`0 0 ${W} ${H}`} class="rating-svg block h-auto w-full touch-pan-y" role="img" aria-label={ratingSummary} tabindex="0">
          <defs>
            <linearGradient id="rating-fill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="var(--accent)" stop-opacity="0.28" />
              <stop offset="1" stop-color="var(--accent)" stop-opacity="0" />
            </linearGradient>
          </defs>
          {grid.map((g) => <line x1={PAD.left} x2={W - PAD.right} y1={y(g)} y2={y(g)} stroke="var(--border)" stroke-dasharray="3 4" />)}
          <path d={area} fill="url(#rating-fill)" />
          <path d={line} fill="none" stroke="var(--accent)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
          <circle cx={endX} cy={endY} r="3" fill="var(--accent)" />
          <circle cx={peakX} cy={peakY} r="4.5" fill="var(--bg)" stroke="var(--accent)" stroke-width="2" />
          <text x={peakX} y={peakY - 10} text-anchor="middle" font-size="11" font-weight="600" fill="var(--fg)">{fmt(leetcode.contests.peak)}</text>
          <line class="rc-guide" y1={PAD.top - 6} y2={H - PAD.bottom} stroke="var(--muted)" stroke-width="1" stroke-dasharray="3 3" opacity="0" />
          <circle class="rc-dot" r="5" fill="var(--fg)" stroke="var(--accent)" stroke-width="2" opacity="0" />
        </svg>
        <div class="rc-tip pointer-events-none absolute z-10 rounded-lg border border-line bg-surface px-2.5 py-1.5 text-center shadow-lg" role="presentation" aria-hidden="true">
          <p class="rc-tip-rating text-sm leading-tight font-semibold"></p>
          <p class="rc-tip-meta font-mono text-xs leading-tight text-muted"></p>
        </div>
        </div>
        <div class="mt-1 flex justify-between font-mono text-xs text-muted" aria-hidden="true">
          <span>{year(tMin)}</span>
          <span>{year(tMax)}</span>
        </div>
        <a href={leetcode.profileUrl} target="_blank" rel="noopener noreferrer" class={sourceLink}>
          See source: LeetCode profile
          <ArrowUpRight size={14} aria-hidden="true" />
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      </li>

      <!-- 3. Other highlights -->
      {
        proof.map((p) => (
          <li class="flex min-w-0 flex-col p-6 lg:pr-0">
            <p class="font-mono text-xs tracking-wider text-muted uppercase">{p.title}</p>
            <p class="mt-1 text-4xl font-bold tracking-tight" data-count={parseFloat(p.value)} data-count-suffix={p.value.replace(/[0-9.,]/g, '')}>{p.value}</p>
            <p class="mt-1 text-muted">{p.label}</p>
            <svg
              viewBox="0 0 320 98"
              class="mem-blocks mt-4 h-auto w-full max-w-[26rem] overflow-visible"
              role="img"
              aria-label="Memory is split into blocks, and each block carries a small metadata header used to manage allocations."
            >
              <text x={BLOCK_X0} y="13" class="font-mono" font-size="9.5" fill="var(--muted)">memory split into blocks</text>
              {
                memoryBlocks.map((i) => (
                  <g class="mem-blk" tabindex="0">
                    <rect x={blockX(i)} y={BLOCK_Y} width={BLOCK_W} height={BLOCK_H} rx="5" fill="var(--bg)" stroke="var(--border)" />
                    <rect x={blockX(i) + 3} y={BLOCK_Y + 3} width={BLOCK_W - 6} height="8" rx="2" fill="var(--warn)" opacity="0.8" />
                    <rect x={blockX(i) + 3} y={BLOCK_Y + 15} width={BLOCK_W - 6} height={BLOCK_H - 18} rx="3" fill="var(--accent)" opacity="0.6" />
                  </g>
                ))
              }
              <g class="font-mono" font-size="8.5" fill="var(--muted)">
                <rect x={BLOCK_X0} y="86" width="8" height="6" rx="1.5" fill="var(--warn)" opacity="0.8" />
                <text x={BLOCK_X0 + 12} y="92">metadata header</text>
                <rect x="120" y="86" width="8" height="6" rx="1.5" fill="var(--accent)" opacity="0.6" />
                <text x="132" y="92">memory</text>
              </g>
            </svg>
            {p.href.length > 0 && (
              <a
                href={p.href}
                target={external(p.href) ? '_blank' : undefined}
                rel={external(p.href) ? 'noopener noreferrer' : undefined}
                class={sourceLink}
              >
                See source: {p.sourceLabel}
                <ArrowUpRight size={14} aria-hidden="true" />
                {external(p.href) && <span class="sr-only">(opens in a new tab)</span>}
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Hovering (or touching, or using the arrow keys on) the rating chart moves a dot along the line and shows that contest's rating.
  type Point = [number, number, number, string];
  const fmtNum = (n: number): string => n.toLocaleString('en-US');

  document.querySelectorAll<HTMLElement>('.rating-chart').forEach((chart) => {
    const svg = chart.querySelector<SVGSVGElement>('.rating-svg');
    const dot = chart.querySelector<SVGCircleElement>('.rc-dot');
    const guide = chart.querySelector<SVGLineElement>('.rc-guide');
    const tip = chart.querySelector<HTMLElement>('.rc-tip');
    const tipRating = chart.querySelector<HTMLElement>('.rc-tip-rating');
    const tipMeta = chart.querySelector<HTMLElement>('.rc-tip-meta');
    if (!svg || !dot || !guide || !tip || !tipRating || !tipMeta) return;

    const W = Number(chart.dataset.w);
    const H = Number(chart.dataset.h);
    const points = JSON.parse(chart.dataset.points ?? '[]') as Point[];
    if (points.length === 0) return;
    let current = -1;

    const show = (i: number): void => {
      const index = Math.max(0, Math.min(points.length - 1, i));
      const [px, py, rating, date] = points[index] as Point;
      current = index;
      dot.setAttribute('cx', String(px));
      dot.setAttribute('cy', String(py));
      guide.setAttribute('x1', String(px));
      guide.setAttribute('x2', String(px));
      dot.setAttribute('opacity', '1');
      guide.setAttribute('opacity', '0.5');

      const previous = index > 0 ? (points[index - 1] as Point)[2] : null;
      const change = previous === null ? 0 : rating - previous;
      const when = new Date(`${date}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
      tipRating.textContent = fmtNum(rating);
      tipMeta.textContent = previous === null ? when : `${change >= 0 ? '+' : '−'}${Math.abs(change)}\n${when}`;

      // Keep the tooltip inside the chart's width.
      const box = chart.getBoundingClientRect();
      const half = tip.offsetWidth / 2;
      const left = Math.max(half, Math.min(box.width - half, (px / W) * box.width));
      tip.style.left = `${left}px`;
      tip.style.top = `${(py / H) * svg.getBoundingClientRect().height}px`;
      tip.dataset.on = 'true';
    };

    const hide = (): void => {
      current = -1;
      dot.setAttribute('opacity', '0');
      guide.setAttribute('opacity', '0');
      delete tip.dataset.on;
    };

    const nearest = (clientX: number): number => {
      const box = svg.getBoundingClientRect();
      const vx = ((clientX - box.left) / box.width) * W;
      let best = 0;
      points.forEach((p, i) => {
        if (Math.abs(p[0] - vx) < Math.abs((points[best] as Point)[0] - vx)) best = i;
      });
      return best;
    };

    svg.addEventListener('pointermove', (e) => show(nearest(e.clientX)));
    // The focus outline is for keyboard users only: a click or tap on the chart shows no outline.
    let usedPointer = false;
    svg.addEventListener('pointerdown', (e) => {
      usedPointer = true;
      svg.removeAttribute('data-keyboard');
      show(nearest(e.clientX));
    });
    svg.addEventListener('focus', () => {
      if (!usedPointer) svg.setAttribute('data-keyboard', 'true');
    });
    svg.addEventListener('pointerleave', hide);
    svg.addEventListener('blur', () => {
      usedPointer = false;
      svg.removeAttribute('data-keyboard');
      hide();
    });
    svg.addEventListener('keydown', (e) => {
      svg.setAttribute('data-keyboard', 'true');
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        show(current < 0 ? (e.key === 'ArrowRight' ? 0 : points.length - 1) : current + (e.key === 'ArrowRight' ? 1 : -1));
      } else if (e.key === 'Escape') {
        hide();
      }
    });
  });
</script>

<script>
  // The highlight numbers count up once when they scroll into view (off with reduced motion).
  import '../scripts/counters';
</script>
